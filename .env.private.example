IS_PRODUCTION=false # obviously, set to true in prod.

#              prod             canary             local dev
# ------------ ---------------- ------------------ ----------------------------------
# PROJECT_NAME chatsift-prod    chatsift-canary    anything distinct
# PREFIX       chatsift-v3      chatsift-canary    chatsift-v3 (keeps existing volumes)
# PROFILES     monitoring       (empty)            (empty)
# IMAGE_CHANNEL main            canary             unused; `./compose up --build` builds locally
COMPOSE_PROJECT_NAME=chatsift-dev
RESOURCE_PREFIX=chatsift-v3
COMPOSE_PROFILES=
IMAGE_CHANNEL=main

ADMINS=000000000000000000

ENCRYPTION_KEY=boop # generate using node -e "console.log(require('crypto').randomBytes(32).toString('base64'));"
OAUTH_DISCORD_CLIENT_SECRET=boop # from your discord application page

# Host-side published ports. LOCAL_API_PORT and LOCAL_REDIS_PORT already default to 7004/6379 in
# .env.public -- override them here only on a second deployment on the same host (canary), where they
# must not collide with prod. An unset LOCAL_* var does not fail: compose renders the mapping with no
# host port and Docker picks a random one, which is why the two that something external depends on
# (Caddy -> the API) are defaulted in .env.public rather than left to this file.
LOCAL_API_PORT=7004
LOCAL_DATABASE_PORT=5432
LOCAL_REDIS_PORT=6379
LOCAL_GRAFANA_PORT=3000
LOCAL_DOZZLE_PORT=8080

GRAFANA_ADMIN_PASSWORD=boop # local break-glass login only, real auth is Discord OAuth via ADMINS
ALERTS_DISCORD_WEBHOOK_URL=boop # Discord webhook Grafana alerting posts to

AMA_BOT_TOKEN=boop
MODMAIL_BOT_TOKEN=boop
SOCIAL_BOT_TOKEN=boop
AUTOMODERATOR_BOT_TOKEN=boop

# Dozzle's webhook destination points at our /v3/logs/webhook route instead of Discord directly, so
# we can prettify the raw JSON it embeds before relaying to the real Discord webhook below.
DOZZLE_WEBHOOK_SECRET=boop # sent by Dozzle via a custom "X-Webhook-Secret" header on the destination, generate using node -e "console.log(require('crypto').randomBytes(32).toString('base64'));"
DOZZLE_WEBHOOK_DISCORD_ID=000000000000000000 # id from the real Discord webhook URL
DOZZLE_WEBHOOK_DISCORD_TOKEN=boop # token from the real Discord webhook URL

# Prometheus scrapes /metrics with this as a Bearer token (issue #277). Generate using
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'));" — the same value
# must ALSO be written to build/prometheus/metrics_secret (gitignored, not templated from this
# file — see docs/workflow.md), since prometheus.yml itself has no env-var expansion mechanism.
METRICS_SECRET=boop

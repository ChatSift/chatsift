ROOT_DOMAIN=automoderator.app

# DB
DATABASE_URL_DEV=postgres://chatsift:admin@127.0.0.1:${LOCAL_DATABASE_PORT}/chatsift
DATABASE_URL_PROD=postgres://chatsift:admin@postgres:5432/chatsift
# Read-only monitoring role for postgres-exporter. Public for the same reason the credentials above are, and
# it is strictly weaker than them -- see build/postgres/init/02-monitoring-role.sh.
POSTGRES_EXPORTER_PASSWORD=admin

# How slow should a PG query be before its flagged as such. Low on purpose: postgres-exporter runs as its own
# role and is exempted from this log, so what is left is queries we actually wrote.
POSTGRES_SLOW_QUERY_LOG_MS=5

# Redis
REDIS_URL_DEV=redis://127.0.0.1:6379
REDIS_URL_PROD=redis://redis:6379
LOCAL_REDIS_PORT=6379

# Metrics
AUTOMODERATOR_METRICS_PORT=7006
AMA_METRICS_PORT=7007
MODMAIL_METRICS_PORT=7008
SOCIAL_METRICS_PORT=7009
APPEALS_METRICS_PORT=7010

# API
API_PORT=7004
OAUTH_DISCORD_CLIENT_ID=1005791929075769344
API_URL_DEV=http://localhost:7004
API_URL_PROD=https://api.automoderator.app
# `unban.app` and its dev port are here alongside the dashboard because both frontends talk to this one API
# (#232 P3) -- the sessions are separated by cookie domain and middleware, not by origin policy.
CORS="http:\/\/localhost:3000|http:\/\/localhost:3001|https:\/\/automoderator\.app|https:\/\/unban\.app"

# Frontend
FRONTEND_URL_DEV=http://localhost:3000
FRONTEND_URL_PROD=https://automoderator.app

# Appeals (#232, docs/roadmap/09-appeals.md). Its own application and its own eTLD+1 -- `unban.app` cannot
# share the dashboard's session, so none of these are the `ROOT_DOMAIN`/`OAUTH_DISCORD_CLIENT_ID` above.
#
# `APPEALS_OAUTH_CLIENT_ID` is in `.env.private` instead, and NOT because it is a secret -- it appears in every
# authorize URL, exactly like the dashboard's. It is there because dev and prod run two *different* Appeals
# applications, and this file is one checked-in value every host shares. The `_DEV`/`_PROD` pair below is the
# usual answer to that and stretches to exactly two environments; `.env.private` is per-host, so canary costs
# nothing when it arrives. Unlike a bot token, losing it is a misconfiguration and not a breach.
APPEALS_ROOT_DOMAIN=unban.app
APPEALS_FRONTEND_URL_DEV=http://localhost:3001
APPEALS_FRONTEND_URL_PROD=https://unban.app
APPEALS_API_URL_DEV=http://localhost:7004
APPEALS_API_URL_PROD=https://api.unban.app

# Proxy. The URL must end in /api.
# `_DEV` is intentionally blank: `yarn dev:*` talks straight to Discord unless you're also running
# `yarn dev:discord-proxy`, in which case set it to http://localhost:${DISCORD_PROXY_PORT}/api.
# Blanking `_PROD` is the production kill switch -- every service goes back to calling Discord directly.
DISCORD_PROXY_PORT=7005
DISCORD_PROXY_URL_DEV=
DISCORD_PROXY_URL_PROD=http://discord-proxy:7005/api

# Frontend error reporting (#386). GlitchTip shares the Postgres instance; this role is strictly
# weaker than the application's own credentials above and postgres is never externally reachable,
# so it is public for the same reason they are -- see build/postgres/init/03-glitchtip.sh.
GLITCHTIP_DB_PASSWORD=admin
# Events live in the *product* database, so this is a disk-pressure decision. Upstream defaults to 90.
GLITCHTIP_RETENTION_DAYS=30

# Horizontal scaling
AUTOMODERATOR_SHARDS_PER_REPLICA=
AMA_SHARDS_PER_REPLICA=
MODMAIL_SHARDS_PER_REPLICA=
SOCIAL_SHARDS_PER_REPLICA=
APPEALS_SHARDS_PER_REPLICA=

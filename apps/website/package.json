{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@chatsift/website",
	"version": "0.1.0",
	"description": "ChatSift primary website",
	"private": true,
	"scripts": {
		"build": "node ../../scripts/sync-web-core-assets.mjs website && next build",
		"dev": "node ../../scripts/sync-web-core-assets.mjs website && next dev",
		"start": "node ../../scripts/sync-web-core-assets.mjs website && next start",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
		"format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
	},
	"dependencies": {
		"@chatsift/api": "workspace:^",
		"@chatsift/core": "workspace:^",
		"@chatsift/discord-utils": "workspace:^",
		"@chatsift/parse-relative-time": "workspace:^",
		"@chatsift/web-core": "workspace:^",
		"@discord/markdown-react": "^0.6.0",
		"@discord/markdown-wasm": "^0.5.0",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-navigation-menu": "^1.2.22",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@sentry/nextjs": "^10.74.0",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/react-virtual": "^3.14.12",
		"babel-plugin-react-compiler": "^1.0.0",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cookie": "^2.0.1",
		"jotai": "^2.20.3",
		"luxon": "^3.7.2",
		"next": "^16.3.5",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-aria-components": "^1.21.1",
		"react-dom": "^19.3.0",
		"react-icons": "^5.7.0",
		"tailwind-merge": "^3.7.0",
		"usehooks-ts": "^3.1.1",
		"zod": "^4.6.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/luxon": "^3.7.5",
		"@types/node": "^24.13.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"discord-api-types": "^0.38.55",
		"eslint": "^9.39.5",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	}
}

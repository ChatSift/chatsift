{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

api.automoderator.app {
	reverse_proxy api:{$API_PORT}
}

grafana.automoderator.app {
	reverse_proxy grafana:3000
}

dozzle.automoderator.app {
	reverse_proxy dozzle:8080
}

errors.automoderator.app {
	# anti-abuse, ingest paths only -- the ones the public DSN lets anyone POST to unauthenticated.
	@ingest path_regexp ^/api/[0-9]+/(envelope|store|security)/
	request_body @ingest {
		max_size 1MB
	}

	reverse_proxy glitchtip:8000
}

# Legacy
interactions.automoderator.app {
	reverse_proxy automoderator-interactions:3002
}

logs.automoderator.app {
	reverse_proxy parseable:8000
}

{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

api.automoderator.app {
	reverse_proxy api:{$API_PORT}
}

grafana.automoderator.app {
	reverse_proxy grafana:3000
}

dozzle.automoderator.app {
	reverse_proxy dozzle:8080
}

errors.automoderator.app {
	# The DSN is public by design, so this route accepts unauthenticated POSTs from anyone -- and every one of
	# them writes into the Postgres the product itself runs on. The client-side event budget in
	# `src/api/report.ts` bounds our own pages, not an attacker. This caps the per-request half of that;
	# GlitchTip's retention caps the total. A real rate limit needs the caddy-ratelimit plugin (an xcaddy
	# build in build/caddy/Dockerfile), which is the follow-up if this route ever actually gets abused.
	request_body {
		max_size 1MB
	}
	reverse_proxy glitchtip:8000
}

# Legacy
interactions.automoderator.app {
	reverse_proxy automoderator-interactions:3002
}

logs.automoderator.app {
	reverse_proxy parseable:8000
}

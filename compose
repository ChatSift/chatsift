#!/bin/bash

if [ "$(git rev-parse --absolute-git-dir 2>/dev/null)" != "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ] && [ -z "${CHATSIFT_ALLOW_WORKTREE_COMPOSE:-}" ]
then
  echo 'refusing to run from a linked git worktree: this would drive the main checkout stack.' >&2
  echo 'Run it from the main checkout, or set CHATSIFT_ALLOW_WORKTREE_COMPOSE=1 to override.' >&2
  exit 1
fi

# Passed to `docker compose` natively so file contents are parsed as plain KEY=value pairs,
# never executed as shell (unlike `source`/`export $(... | xargs)`, both of which let a value
# containing $(...) or backticks run arbitrary commands).
#
# Merged into a single temp file rather than passed as two separate --env-file flags: compose
# only uses the FIRST --env-file for interpolating docker-compose.yml itself (e.g. the
# ${LOCAL_DATABASE_PORT} port mapping) - a second flag is silently ignored for that purpose,
# even though per-service `env_file:` lists do merge both files correctly. A single merged
# file sidesteps the ordering footgun entirely.
ENV_FILE_ARGS=()
if [ -f .env.public ] || [ -f .env.private ]
then
  MERGED_ENV_FILE="$(mktemp)"
  trap 'rm -f "$MERGED_ENV_FILE"' EXIT
  [ -f .env.public ] && cat .env.public >> "$MERGED_ENV_FILE"
  [ -f .env.private ] && cat .env.private >> "$MERGED_ENV_FILE"
  ENV_FILE_ARGS+=(--env-file "$MERGED_ENV_FILE")
fi

# Grafana's Discord-login allowlist is derived from ADMINS so it stays a single source of
# truth. Extracted with grep/cut (no shell evaluation of the file's contents) and strictly
# validated as a comma-separated list of numeric Discord snowflakes before use.
admins_raw=''
if [ -f .env.private ]
then
  admins_raw="$(grep -m1 '^ADMINS=' .env.private | cut -d= -f2-)"
fi

if [ -n "$admins_raw" ]
then
  if ! [[ "$admins_raw" =~ ^[0-9]+(,[[:space:]]*[0-9]+)*$ ]]
  then
    echo "ADMINS in .env.private must be a comma-separated list of numeric Discord IDs, got: $admins_raw" >&2
    exit 1
  fi

  IFS=', ' read -ra _admin_ids <<< "$admins_raw"
  _quoted_ids=""
  for _id in "${_admin_ids[@]}"
  do
    _quoted_ids="${_quoted_ids}${_quoted_ids:+,}'${_id}'"
  done
  export GRAFANA_OAUTH_ROLE_ATTRIBUTE_PATH="contains([${_quoted_ids}],id)&&'Admin'"
fi

# Replica counts for sharded bots are computed here rather than written down anywhere, so the only
# number a human maintains is <BOT>_SHARDS_PER_REPLICA. Discord's own /gateway/bot recommendation
# decides the shard count; each replica then works out which slice is its own against redis (see
# packages/private/bot-core/src/lib/replica.ts).
#
# Host-side on purpose: this box already has docker access, so nothing needs the docker socket
# mounted into a container that processes untrusted Discord input.
# Same precedence as the merged env file above (.env.private is concatenated last, so it wins), and the
# same grep/cut approach as the ADMINS block: read the value without ever letting the file's contents be
# evaluated as shell.
#
# Presence in .env.private wins, not just a non-empty value there. `KEY=` is a deliberate "not configured
# here" -- it is how .env.public spells the default -- and `${private:-$public}` would silently fall back
# to the public value instead. The container reads the merged file and would see the empty one, so this
# script must agree with it or it would size a service from a value the bots themselves never receive.
read_env() {
  local key="$1" value=''

  if [ -f .env.public ] && grep -q "^${key}=" .env.public
  then
    value="$(grep -m1 "^${key}=" .env.public | cut -d= -f2-)"
  fi

  if [ -f .env.private ] && grep -q "^${key}=" .env.private
  then
    value="$(grep -m1 "^${key}=" .env.private | cut -d= -f2-)"
  fi

  printf '%s' "$value"
}

# One docker-compose.yml now serves two deployments on the same host (prod and canary), so the
# project name and the active profiles are per-checkout state rather than something committed. Both
# are passed as real CLI flags instead of relying on compose picking COMPOSE_* up from the merged
# --env-file: this script has already been bitten once by compose only honouring the *first*
# --env-file (see the comment at the top), and `-p`/`--profile` leave nothing to infer.
#
# Hard failure rather than a default on purpose. A canary checkout that fell back to prod's project
# name would adopt prod's containers and start a second Postgres against prod's volume.
PROJECT="$(read_env COMPOSE_PROJECT_NAME)"
if [ -z "$PROJECT" ]
then
  echo 'COMPOSE_PROJECT_NAME must be set in .env.private (e.g. chatsift-prod, chatsift-canary)' >&2
  exit 1
fi

# Volumes and the network are named from RESOURCE_PREFIX, deliberately *not* from the project name --
# see the comment above `volumes:` in docker-compose.yml. Checked here so a missing value fails loudly
# instead of interpolating to `-postgres-data` and silently provisioning an empty database.
if [ -z "$(read_env RESOURCE_PREFIX)" ]
then
  echo 'RESOURCE_PREFIX must be set in .env.private (prod uses chatsift-v3 -- see docker-compose.yml)' >&2
  exit 1
fi

PROFILE_ARGS=()
_profiles="$(read_env COMPOSE_PROFILES | tr ',' ' ')"
for _profile in $_profiles
do
  PROFILE_ARGS+=(--profile "$_profile")
done

SCALE_ARGS=()
plan_scale() {
  local service="$1" token_key="$2" shards_per_replica_key="$3"
  local shards_per_replica token response shards replicas running

  shards_per_replica="$(read_env "$shards_per_replica_key")"
  # Unset means this bot isn't sharded across replicas, which is the default -- leave compose alone.
  [ -n "$shards_per_replica" ] || return 0
  if ! [[ "$shards_per_replica" =~ ^[0-9]+$ ]] || [ "$shards_per_replica" -lt 1 ]
  then
    echo "${shards_per_replica_key} must be a positive integer, got: ${shards_per_replica}" >&2
    exit 1
  fi

  token="$(read_env "$token_key")"
  if [ -z "$token" ]
  then
    echo "warning: ${shards_per_replica_key} is set but ${token_key} is empty; leaving ${service} scale untouched" >&2
    return 0
  fi

  # The token goes in via a curl config on stdin rather than as an argument: anything in argv is readable
  # from the process list by any local user for as long as the request runs.
  response="$(printf 'header = "Authorization: Bot %s"\nsilent\nshow-error\nmax-time = 10\nurl = "%s"\n' \
    "$token" 'https://discord.com/api/v10/gateway/bot' | curl -K - 2>/dev/null)" || response=''
  shards="$(printf '%s' "$response" | grep -o '"shards"[[:space:]]*:[[:space:]]*[0-9]\+' | grep -o '[0-9]\+$')"

  if ! [[ "$shards" =~ ^[0-9]+$ ]] || [ "$shards" -lt 1 ]
  then
    # Deliberately keeps whatever is already running instead of falling back to 1: silently scaling a
    # sharded bot down to a single replica because Discord was briefly unreachable would be a far worse
    # outcome than deploying with a stale-but-correct replica count.
    running="$(docker compose -p "$PROJECT" -f docker-compose.yml "${ENV_FILE_ARGS[@]}" ps -q "$service" 2>/dev/null | grep -c .)"
    if [ "${running:-0}" -gt 0 ]
    then
      echo "warning: could not read Discord's shard count for ${service}; holding at ${running} replica(s)" >&2
      SCALE_ARGS+=(--scale "${service}=${running}")
    else
      echo "warning: could not read Discord's shard count for ${service}; leaving its scale untouched" >&2
    fi

    return 0
  fi

  replicas=$(( (shards + shards_per_replica - 1) / shards_per_replica ))
  echo "${service}: ${shards} shard(s) / ${shards_per_replica} per replica -> ${replicas} replica(s)"
  SCALE_ARGS+=(--scale "${service}=${replicas}")
}

ROLLABLE='api ama-bot modmail-bot modmail-bot-nascar social-bot appeals-bot automoderator-bot'

compose_do() {
  docker compose -p "$PROJECT" -f docker-compose.yml "${PROFILE_ARGS[@]}" "${ENV_FILE_ARGS[@]}" "$@"
}

running_ids() {
  compose_do ps -q "$1"
}

container_name() {
  docker inspect -f '{{.Name}}' "$1" 2>/dev/null | sed 's|^/||' || echo "$1"
}

roll_service() {
  local service="$1" old_ids='' seen='' count=0 rolled=0 old new status name

  if ! old_ids="$(running_ids "$service")"
  then
    echo "${service}: could not list containers" >&2
    return 1
  fi

  old_ids="$(echo $old_ids)"
  for _ in $old_ids
  do
    count=$(( count + 1 ))
  done

  if [ "$count" -eq 0 ]
  then
    echo "${service}: nothing running, starting it normally"
    compose_do up -d "$service"
    return 0
  fi

  seen=" ${old_ids} "
  echo "${service}: rolling ${count} container(s)"

  for old in $old_ids
  do
    if ! compose_do up -d --no-recreate --scale "${service}=$(( count + 1 ))" "$service"
    then
      echo "${service}: failed to add a replacement container" >&2
      roll_partial_note "$service" "$rolled" "$count"
      return 1
    fi

    new=''
    for id in $(running_ids "$service")
    do
      case "$seen" in
        *" $id "*) ;;
        *) new="$id" ;;
      esac
    done

    if [ -z "$new" ]
    then
      echo "${service}: no new container appeared" >&2
      roll_partial_note "$service" "$rolled" "$count"
      return 1
    fi

    seen="${seen}${new} "
    name="$(container_name "$new")"

    status=''
    for _ in $(seq 1 "${ROLL_HEALTH_TIMEOUT:-180}")
    do
      status="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$new" 2>/dev/null || echo gone)"
      case "$status" in
        # `gone` means it crashed and was removed -- no point waiting out the timeout for a container that
        # no longer exists.
        healthy|none|gone) break ;;
      esac
      sleep 1
    done

    case "$status" in
      healthy|none) ;;
      *)
        echo "${service}: ${name} never became healthy (${status})" >&2
        echo "--- last 50 log lines from ${name} ---" >&2
        docker logs --tail 50 "$new" >&2 2>&1 || true
        echo "--- end ${name} ---" >&2

        if [ "$status" != gone ]
        then
          docker stop "$new" >/dev/null 2>&1 || docker kill "$new" >/dev/null 2>&1 || true
          if ! docker rm -f "$new" >/dev/null 2>&1
          then
            echo "${service}: FAILED to remove ${name} -- it is still on the network and may take traffic." >&2
            echo "${service}: remove it by hand: docker rm -f ${new}" >&2
          fi
        fi

        roll_partial_note "$service" "$rolled" "$count"
        return 1
        ;;
    esac

    echo "  ${name} ready (${status}); retiring $(container_name "$old")"

    if ! docker stop "$old" >/dev/null 2>&1
    then
      echo "${service}: failed to stop $(container_name "$old"); it and ${name} are both running" >&2
      return 1
    fi

    if ! docker rm "$old" >/dev/null 2>&1
    then
      echo "${service}: stopped but could not remove $(container_name "$old")" >&2
      return 1
    fi

    rolled=$(( rolled + 1 ))
  done
}

roll_partial_note() {
  local service="$1" rolled="$2" count="$3"

  if [ "$rolled" -gt 0 ]
  then
    echo "${service}: ${rolled} of ${count} container(s) were already replaced and are NOT rolled back" >&2
  else
    echo "${service}: no containers were retired; it is as it was before the roll" >&2
  fi
}

if [ "$1" = 'roll' ]
then
  shift
  services="${*:-$ROLLABLE}"
  failed=''
  for _service in $services
  do
    roll_service "$_service" || failed="${failed}${_service} "
  done

  if [ -n "$failed" ]
  then
    echo "roll failed for: ${failed}" >&2
    exit 1
  fi

  exit 0
fi

if [ "$1" != 'up' ]
then
  case " $* " in
    *' up '*)
      echo 'put `up` first: ./compose up [args]. Global flags before it would skip replica sizing and the' >&2
      echo 'healthcheck gate; profiles are read from COMPOSE_PROFILES in .env.private.' >&2
      exit 1
      ;;
  esac
fi

# Only for `up`. Every other subcommand (logs, stop, ps, exec, ...) must not silently restructure the
# deployment, and `--scale` isn't meaningful for them anyway.
if [ "$1" = 'up' ]
then
  plan_scale ama-bot AMA_BOT_TOKEN AMA_SHARDS_PER_REPLICA
  # Only the public deployment: a custom instance (#216) is single-guild by definition, so it is always
  # one shard and one replica.
  plan_scale modmail-bot MODMAIL_BOT_TOKEN MODMAIL_SHARDS_PER_REPLICA
  plan_scale social-bot SOCIAL_BOT_TOKEN SOCIAL_SHARDS_PER_REPLICA
  plan_scale automoderator-bot AUTOMODERATOR_BOT_TOKEN AUTOMODERATOR_SHARDS_PER_REPLICA
fi

WAIT_ARGS=()
if [ "$1" = 'up' ] && [ -z "${CHATSIFT_NO_WAIT:-}" ]
then
  case " $* " in
    *' --wait '*|*' --wait-timeout '*|*' --wait-timeout='*) ;;
    *' -d '*|*' --detach '*) WAIT_ARGS+=(--wait --wait-timeout 300) ;;
  esac
fi

docker compose \
  -p "$PROJECT" \
  -f docker-compose.yml \
  "${PROFILE_ARGS[@]}" \
  "${ENV_FILE_ARGS[@]}" \
  "$@" \
  "${SCALE_ARGS[@]}" \
  "${WAIT_ARGS[@]}"

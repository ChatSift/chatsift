{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@chatsift/core",
	"version": "0.1.0",
	"description": "Core utils and types for cross-service interaction",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
		"format:check": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
		"clean": "rimraf dist"
	},
	"devDependencies": {
		"@chatsift/db": "workspace:^",
		"@types/node": "^24.13.4",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sapphire/bitfield": "^1.2.4",
		"discord-api-types": "^0.38.55",
		"murmurhash": "^2.0.1"
	}
}

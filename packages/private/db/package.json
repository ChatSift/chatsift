{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@chatsift/db",
	"version": "0.1.0",
	"description": "Database schema, migrations, and query client (postgres.js + Atlas + kanel)",
	"private": true,
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
		"format:check": "prettier --check . --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
		"clean": "rimraf dist",
		"db:gen": "kanel",
		"db:migrate": "atlas migrate apply --env local",
		"db:migrate:down": "atlas migrate down --env local",
		"db:diff": "atlas migrate diff --env local",
		"db:hash": "atlas migrate hash --env local",
		"tag-docker": "docker buildx imagetools create -t ${IMAGE_REPO}:${IMAGE_CHANNEL}-migrate ${IMAGE_REPO}:${IMAGE_CHANNEL}-${GITHUB_SHA}"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@kristiandupont/recase": "^1.4.1",
		"@types/node": "^24.13.4",
		"kanel": "^4.0.4",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"postgres": "^3.4.9"
	}
}

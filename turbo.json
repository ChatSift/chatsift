{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "package.json", "tsconfig.json", "tsup.config.ts", "$TURBO_ROOT$/tsup.config.ts"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"lint": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.js", "$TURBO_ROOT$/tsconfig.eslint.json"]
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "vitest.config.ts", "tsconfig.json", "package.json", "$TURBO_ROOT$/vitest.shared.ts"],
			"outputs": ["coverage/**"]
		},
		"format": {
			"cache": false
		},
		"format:check": {
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/.prettierrc.json",
				"$TURBO_ROOT$/.prettierignore",
				"$TURBO_ROOT$/.prettierignore.workspaces"
			]
		},
		"clean": {
			"cache": false
		},
		"db:gen": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:migrate:down": {
			"cache": false
		},
		"db:diff": {
			"cache": false
		},
		"tag-docker": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": [],
			"passThroughEnv": ["IMAGE_REPO", "IMAGE_CHANNEL", "GITHUB_SHA"],
			"inputs": [
				"src/**/*.ts",
				"$TURBO_ROOT$/Dockerfile",
				"$TURBO_ROOT$/docker-compose.yml",
				"$TURBO_ROOT$/.env.public",
				"$TURBO_ROOT$/compose"
			]
		}
	},
	"globalDependencies": ["tsconfig.json", "tsconfig.base.json"]
}

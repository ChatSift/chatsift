{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"lint": {
			"dependsOn": ["^build"]
		},
		"lint:fix": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "vitest.config.ts", "tsconfig.json", "package.json"],
			"outputs": ["coverage/**"]
		},
		"format": {
			"cache": false
		},
		"format:check": {},
		"clean": {
			"cache": false
		},
		"db:gen": {
			"cache": false
		},
		"db:migrate": {
			"cache": false
		},
		"db:migrate:down": {
			"cache": false
		},
		"db:diff": {
			"cache": false
		},
		"tag-docker": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": [],
			"inputs": [
				"src/**/*.ts",
				"$TURBO_ROOT$/Dockerfile",
				"$TURBO_ROOT$/docker-compose.yml",
				"$TURBO_ROOT$/.env.public",
				"$TURBO_ROOT$/compose"
			]
		}
	},
	"globalDependencies": [
		"eslint.config.js",
		".prettierrc.json",
		".prettierignore",
		".prettierignore.workspaces",
		"tsconfig.json",
		"tsconfig.*.json",
		"vitest.shared.ts"
	]
}
